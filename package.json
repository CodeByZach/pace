{
  "name": "pace-js",
  "version": "1.2.4",
  "description": "Automatically add a progress bar to your site.",
  "main": "pace.js",
  "files": [
    "pace.js",
    "pace.min.js",
    "pace-theme-default.css",
    "pace-theme-default.min.css",
    "templates/",
    "themes/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:syntax && npm run test:browsers",
    "test:syntax": "acorn --ecma5 --silent pace.js pace.min.js",
    "test:browsers": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByZach/pace.git"
  },
  "keywords": [
    "pace",
    "pace-js",
    "pace.js",
    "progress-bar",
    "loading-bar",
    "loading-indicator",
    "loading-animation"
  ],
  "author": "CodeByZach <codebyzach@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CodeByZach/pace/issues"
  },
  "homepage": "https://github.com/CodeByZach/pace#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2"
  }
}
